{
  "info": {
    "name": "Baozi Store API",
    "description": "Coleção para testar a API REST da Baozi Store. Rode as pastas 1 a 4 na ordem (ou use o Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Criar (POST)",
      "item": [
        {
          "name": "POST Criar Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Fabiano2042149\",\n  \"clienteDesde\": \"2026-10-12\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('clienteId', body.id);",
                  "pm.test('Nome do cliente = Fabiano2042149', function () { pm.expect(body.nome).to.eql('Fabiano2042149'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Criar Produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Baozi de Carne\",\n  \"preco\": 8.5,\n  \"estoque\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('produtoId', body.id);",
                  "pm.test('Produto = Baozi de Carne', function () { pm.expect(body.nome).to.eql('Baozi de Carne'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Criar Pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"produtoId\": \"{{produtoId}}\",\n  \"quantidade\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('pedidoId', body.id);",
                  "pm.test('Pedido de 3 unidades do cliente Fabiano2042149', function () { pm.expect(body.quantidade).to.eql(3); pm.expect(body.clienteNome).to.eql('Fabiano2042149'); pm.expect(body.produtoNome).to.eql('Baozi de Carne'); });"
                ]
              }
            }
          ]
        }
      ]
    },
