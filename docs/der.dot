digraph DER {
  rankdir=LR; bgcolor="white"; nodesep=0.9; ranksep=1.3;
  node [shape=plaintext fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=11 arrowhead=none];
  Cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
    <TR><TD BGCOLOR="#dfe9f5"><B>CLIENTE</B></TD></TR>
    <TR><TD ALIGN="LEFT"><U>id</U> : Long (PK)</TD></TR>
    <TR><TD ALIGN="LEFT">nome : String</TD></TR>
    <TR><TD ALIGN="LEFT">clienteDesde : LocalDate</TD></TR></TABLE>>];
  Produto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
    <TR><TD BGCOLOR="#dfe9f5"><B>PRODUTO</B></TD></TR>
    <TR><TD ALIGN="LEFT"><U>id</U> : Long (PK)</TD></TR>
    <TR><TD ALIGN="LEFT">nome : String</TD></TR>
    <TR><TD ALIGN="LEFT">preco : BigDecimal</TD></TR>
    <TR><TD ALIGN="LEFT">estoque : Boolean</TD></TR></TABLE>>];
  Pedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
    <TR><TD BGCOLOR="#f5e6d3"><B>PEDIDO</B></TD></TR>
    <TR><TD ALIGN="LEFT"><U>id</U> : Long (PK)</TD></TR>
    <TR><TD ALIGN="LEFT">clienteId : Long (FK)</TD></TR>
    <TR><TD ALIGN="LEFT">produtoId : Long (FK)</TD></TR>
    <TR><TD ALIGN="LEFT">quantidade : Integer</TD></TR></TABLE>>];
  Cliente -> Pedido [headlabel="N" taillabel="1" label="realiza" labeldistance=2.5];
  Produto -> Pedido [headlabel="N" taillabel="1" label="é comprado em" labeldistance=2.5];
}
